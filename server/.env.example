# ─── Server ──────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit the real .env.

# HTTP port
PORT=5000

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DB_NAME=luk_kenya
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin account created by `npm run create-admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── URLs ────────────────────────────────────────────────────────────────────
# Absolute origin of this API. Used to build the Google OAuth callback URL,
# which Google requires to be absolute (not a relative path).
SERVER_URL=http://localhost:5000

# Absolute origin of the frontend. Used for OAuth redirects after login.
# Must match the Vite dev server port in vite.config.js.
FRONTEND_URL=http://localhost:3000

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# Leave both blank to disable Google sign-in. The API starts fine without them.
# In the Google Cloud console, register this exact redirect URI:
#   {SERVER_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── NSE market data (optional) ───────────────────────────────────────────────
# The market dashboard reads the official NSE ticker service. No API key is
# required; these only tune caching and the identifier the feed expects.
# NSE only answers requests that appear to originate from nse.co.ke, so the
# fetch is always made server side and never from the browser.

# Seconds an upstream NSE response is reused before refetching.
NSE_CACHE_TTL_MS=60000

# Identifier NSE's own ticker widget passes. Change only if NSE issues you one.
NSE_TICKER_ISINNO=KE3000009674

# ─── Optional integrations ───────────────────────────────────────────────────
# Only listed for future use. No code currently reads these, and the relevant
# packages are not installed. Remove any you are not using so stale credentials
# are not left lying around.
#
# SMTP / email
# SMT_HOST=
# SMT_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
#
# SendGrid
# SENDGRID_API_KEY=
#
# Cloudinary
# CLAUDINARY_CLOUD_NAME=
# CLAUDINARY_API_KEY=
# CLAUDINARY_API_SECRET=
#
# AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
