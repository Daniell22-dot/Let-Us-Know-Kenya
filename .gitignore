# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables -- never commit real secrets.
# Only the real files are ignored. The `.env.example` templates hold no
# credentials and are tracked on purpose; a bare `.env.example` pattern here
# would also match server/.env.example and drop it from the repository.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!server/.env.example

# Build output
dist/
dist-ssr/
build/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage output
coverage/
*.tsbuildinfo

# Runtime uploads (user-supplied files)
server/uploads/

# Editor / OS noise
.vscode/
.idea/
*.iml
*.swp
.DS_Store
Thumbs.db
